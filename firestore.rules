rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner() {
      return signedIn()
        && request.auth.token.email == 'djodjojsk6@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function orderAfter(orderId) {
      return getAfter(/databases/$(database)/documents/orders/$(orderId));
    }

    function orderExpired(orderId) {
      let before = get(/databases/$(database)/documents/orders/$(orderId));
      let after = orderAfter(orderId);
      return signedIn()
        && before.data.status == 'Nouvelle'
        && request.time >= before.data.expiresAt
        && after.data.status == 'Expirée'
        && after.data.expiredAt == request.time;
    }

    function validOrderCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'orderNumber', 'deliveryCode', 'phone', 'items', 'itemQuantities', 'subtotalFc',
          'deliveryType', 'areaId', 'areaName', 'deliveryFeeFc',
          'address', 'landmark', 'mapUrl', 'deliveryDate', 'slotId',
          'slotLabel', 'slotKey', 'gift', 'promoCode', 'promoCollection', 'discountFc', 'totalFc',
          'depositFc', 'paymentProvider', 'paymentNumber', 'status',
          'expiresAt', 'createdAt', 'history'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.matches('^LM-[0-9]{6}-[0-9]{4}$')
        && request.resource.data.deliveryCode is string
        && request.resource.data.deliveryCode.matches('^[0-9]{4}$')
        && request.resource.data.status == 'Nouvelle'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10
        && request.resource.data.itemQuantities is map
        && request.resource.data.itemQuantities.size() == request.resource.data.items.size()
        && request.resource.data.subtotalFc is int
        && request.resource.data.subtotalFc >= 0
        && request.resource.data.deliveryFeeFc is int
        && request.resource.data.deliveryFeeFc >= 0
        && request.resource.data.discountFc is int
        && request.resource.data.discountFc >= 0
        && request.resource.data.discountFc <= request.resource.data.subtotalFc
        && request.resource.data.totalFc == request.resource.data.subtotalFc + request.resource.data.deliveryFeeFc - request.resource.data.discountFc
        && request.resource.data.depositFc is int
        && request.resource.data.depositFc >= 0
        && request.resource.data.deliveryType in ['retrait', 'livraison', 'campus']
        && request.resource.data.gift is map
        && request.resource.data.history is list
        && request.resource.data.history.size() == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');
    }

    function expireOrder(orderId) {
      return orderExpired(orderId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiredAt', 'history'])
        && request.resource.data.status == 'Expirée';
    }

    function reportDeliveredOrder() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'Livrée'
        && request.resource.data.status == 'litige'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function anonymizeOwnOrder() {
      let privateFields = ['uid', 'phone', 'address', 'landmark', 'mapUrl', 'deliveryCode', 'gift'];
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(privateFields)
        && !request.resource.data.keys().hasAny(privateFields);
    }

    function anonymizeOwnPromoRedemption() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && !request.resource.data.keys().hasAny(['uid']);
    }

    function anonymizeOwnProductQuestion() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && !request.resource.data.keys().hasAny(['uid']);
    }

    function reserveInventory(inventoryId) {
      let orderId = request.resource.data.lastOrderId;
      let order = orderAfter(orderId).data;
      let quantity = order.itemQuantities[inventoryId];
      let changedHolds = request.resource.data.holds.diff(resource.data.holds);
      let productId = ('productId' in resource.data) ? resource.data.productId : inventoryId;
      let product = get(/databases/$(database)/documents/products/$(productId));
      let stockQty = ('stockQty' in resource.data) ? resource.data.stockQty : product.data.qty;
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedQty', 'holds', 'lastOrderId'])
        && order.uid == request.auth.uid
        && order.status == 'Nouvelle'
        && order.expiresAt > request.time
        && quantity is int
        && quantity > 0
        && !resource.data.holds.keys().hasAny([orderId])
        && changedHolds.addedKeys().hasOnly([orderId])
        && changedHolds.removedKeys().size() == 0
        && request.resource.data.holds[orderId] == quantity
        && request.resource.data.reservedQty == resource.data.reservedQty + quantity
        && request.resource.data.reservedQty <= stockQty;
    }

    function releaseInventory(inventoryId) {
      let orderId = request.resource.data.lastOrderId;
      let order = orderAfter(orderId).data;
      let quantity = resource.data.holds[orderId];
      let changedHolds = resource.data.holds.diff(request.resource.data.holds);
      return orderExpired(orderId)
        && order.itemQuantities[inventoryId] == quantity
        && changedHolds.addedKeys().size() == 0
        && changedHolds.removedKeys().hasOnly([orderId])
        && changedHolds.removedKeys().hasAny([orderId])
        && request.resource.data.reservedQty == resource.data.reservedQty - quantity
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedQty', 'holds', 'lastOrderId']);
    }

    function reserveSlot(slotKey) {
      let orderId = request.resource.data.lastOrderId;
      let order = orderAfter(orderId).data;
      let changedHolds = request.resource.data.holds.diff(resource.data.holds);
      let shop = get(/databases/$(database)/documents/settings/shop).data;
      return signedIn()
        && order.uid == request.auth.uid
        && order.status == 'Nouvelle'
        && order.expiresAt > request.time
        && order.slotKey == slotKey
        && order.slotKey == order.deliveryDate + '_' + order.slotId
        && !resource.data.holds.keys().hasAny([orderId])
        && changedHolds.addedKeys().hasOnly([orderId])
        && changedHolds.removedKeys().size() == 0
        && request.resource.data.holds[orderId] == true
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'holds', 'lastOrderId'])
        && shop.slotMaxima[order.slotId] is int
        && request.resource.data.count <= shop.slotMaxima[order.slotId];
    }

    function createSlot(slotKey) {
      let orderId = request.resource.data.lastOrderId;
      let order = orderAfter(orderId).data;
      let shop = get(/databases/$(database)/documents/settings/shop).data;
      return signedIn()
        && request.resource.data.keys().hasOnly(['count', 'holds', 'lastOrderId'])
        && request.resource.data.count == 1
        && request.resource.data.holds.keys().hasOnly([orderId])
        && request.resource.data.holds[orderId] == true
        && order.uid == request.auth.uid
        && order.status == 'Nouvelle'
        && order.expiresAt > request.time
        && order.slotKey == slotKey
        && order.slotKey == order.deliveryDate + '_' + order.slotId
        && shop.slotMaxima[order.slotId] is int
        && request.resource.data.count <= shop.slotMaxima[order.slotId];
    }

    function releaseSlot(slotKey) {
      let orderId = request.resource.data.lastOrderId;
      let changedHolds = resource.data.holds.diff(request.resource.data.holds);
      return orderExpired(orderId)
        && orderAfter(orderId).data.slotKey == slotKey
        && resource.data.holds[orderId] == true
        && changedHolds.addedKeys().size() == 0
        && changedHolds.removedKeys().hasOnly([orderId])
        && changedHolds.removedKeys().hasAny([orderId])
        && request.resource.data.count == resource.data.count - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'holds', 'lastOrderId']);
    }

    function reservePromo(code) {
      let orderId = request.resource.data.lastOrderId;
      let order = orderAfter(orderId).data;
      return signedIn()
        && resource.data.active == true
        && resource.data.usedCount < resource.data.usageLimit
        && resource.data.expiresAt > request.time
        && order.uid == request.auth.uid
        && order.status == 'Nouvelle'
        && order.promoCode == code
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'lastOrderId']);
    }

    function releasePromo() {
      let orderId = request.resource.data.lastOrderId;
      return orderExpired(orderId)
        && orderAfter(orderId).data.promoCode == resource.data.code
        && resource.data.usedCount > 0
        && request.resource.data.usedCount == resource.data.usedCount - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'lastOrderId']);
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /users/{userId} {
      allow read: if owner() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'favs', 'phone', 'addresses', 'language',
          'university', 'neighborhood', 'neighborhoodName', 'onboardingComplete',
          'wishlistShareEnabled', 'wishlistShareId'
        ])
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('favs' in request.resource.data) || request.resource.data.favs is list)
        && (!('addresses' in request.resource.data)
          || (request.resource.data.addresses is list && request.resource.data.addresses.size() <= 10))
        && (!('language' in request.resource.data) || request.resource.data.language == 'fr')
        && (!('university' in request.resource.data) || (request.resource.data.university is string && request.resource.data.university.size() <= 120))
        && (!('neighborhood' in request.resource.data) || (request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 100))
        && (!('neighborhoodName' in request.resource.data) || (request.resource.data.neighborhoodName is string && request.resource.data.neighborhoodName.size() <= 100))
        && (!('onboardingComplete' in request.resource.data) || request.resource.data.onboardingComplete is bool)
        && (!('wishlistShareEnabled' in request.resource.data) || request.resource.data.wishlistShareEnabled is bool)
        && (!('wishlistShareId' in request.resource.data) || (request.resource.data.wishlistShareId is string && request.resource.data.wishlistShareId.size() <= 64));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/cart/{cartId} {
      allow read: if owner() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && cartId == 'current'
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner() || (signedIn() && request.auth.uid == userId);
    }

    match /{path=**}/cart/{cartId} {
      allow read: if owner();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['type', 'title', 'message', 'target', 'read', 'createdAt'])
        && request.resource.data.type in ['order', 'stock', 'announcement']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 200
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/stockAlerts/{productId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['alertId', 'createdAt'])
        && request.resource.data.alertId is string
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    match /wishlistShares/{shareId} {
      allow get: if resource.data.active == true || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'active', 'products', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == false
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid', 'active', 'products', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /settings/shop {
      allow read: if signedIn();
      allow write: if owner();
    }

    match /settings/deliveryPrivate {
      allow read, write: if owner();
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    match /zones/{zoneId} {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /pickupPoints/{pickupPointId} {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /productQuestions/{questionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['productId', 'uid', 'question', 'createdAt'])
        && request.resource.data.productId is string
        && (!('published' in get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data)
          || get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.published == true)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 10
        && request.resource.data.question.size() <= 500
        && !request.resource.data.question.matches('(?s).*[0-9]([ .()/-]*[0-9]){6,}.*')
        && request.resource.data.createdAt == request.time;
      allow update: if (owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 1000
        && request.resource.data.answeredAt == request.time)
        || anonymizeOwnProductQuestion();
      allow delete: if owner();
    }

    match /orders/{orderId} {
      allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validOrderCreate();
      allow update: if owner() || expireOrder(orderId) || reportDeliveredOrder() || anonymizeOwnOrder();
      allow delete: if false;
    }

    match /inventory/{productId} {
      allow read: if signedIn();
      allow create: if owner();
      allow update: if owner() || reserveInventory(productId) || releaseInventory(productId);
      allow delete: if owner();
    }

    match /reservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'productId', 'variantId', 'inventoryId', 'qty', 'status', 'expiresAt'])
        && reservationId == request.resource.data.orderId + '_' + request.resource.data.inventoryId
        && request.resource.data.orderId is string
        && request.resource.data.productId is string
        && request.resource.data.variantId is string
        && request.resource.data.inventoryId is string
        && request.resource.data.qty is int
        && request.resource.data.status == 'Nouvelle'
        && orderAfter(request.resource.data.orderId).data.uid == request.auth.uid
        && orderAfter(request.resource.data.orderId).data.status == 'Nouvelle'
        && orderAfter(request.resource.data.orderId).data.itemQuantities[request.resource.data.inventoryId] == request.resource.data.qty
        && ((('productId' in get(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId)).data)
              && get(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId)).data.productId == request.resource.data.productId
              && get(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId)).data.variantId == request.resource.data.variantId)
            || (!('productId' in get(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId)).data)
              && request.resource.data.inventoryId == request.resource.data.productId
              && request.resource.data.variantId == ''))
        && request.resource.data.expiresAt == orderAfter(request.resource.data.orderId).data.expiresAt;
      allow update: if owner() || (
        orderExpired(resource.data.orderId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'Expirée'
      );
      allow delete: if false;
    }

    match /slotReservations/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'slotKey', 'status', 'expiresAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'Nouvelle'
        && orderAfter(orderId).data.uid == request.auth.uid
        && orderAfter(orderId).data.status == 'Nouvelle'
        && orderAfter(orderId).data.slotKey == request.resource.data.slotKey
        && request.resource.data.expiresAt == orderAfter(orderId).data.expiresAt;
      allow update: if owner() || (
        orderExpired(orderId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'Expirée'
      );
      allow delete: if false;
    }

    match /slotCounters/{slotKey} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'holds', 'lastOrderId'])
        && createSlot(slotKey);
      allow update: if owner() || reserveSlot(slotKey) || releaseSlot(slotKey);
      allow delete: if owner();
    }

    match /promoCodes/{code} {
      allow get: if signedIn();
      allow list: if owner();
      allow create, delete: if owner();
      allow update: if owner() || reservePromo(code) || releasePromo();
    }

    match /promos/{code} {
      allow get: if signedIn();
      allow list: if owner();
      allow create, delete: if owner();
      allow update: if owner() || reservePromo(code) || releasePromo();
    }

    match /promoRedemptions/{orderId} {
      allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'code', 'orderId', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'Nouvelle'
        && orderAfter(orderId).data.uid == request.auth.uid
        && orderAfter(orderId).data.promoCode == request.resource.data.code;
      allow update: if owner() || anonymizeOwnPromoRedemption() || (
        signedIn()
        && orderExpired(orderId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'Expirée'
      );
      allow delete: if owner();
    }

    match /orderFinance/{orderId} {
      allow read, write: if owner();
    }
  }
}
